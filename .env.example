ATOMCAM_URL=http://192.168.1.80
WEB_LISTEN_ADDRESS=0.0.0.0:8080

# camera pan = PAN_OFFSET + PAN_SCALE * satellite azimuth
# Default assumes raw pan 180 / tilt 90 is the camera's front-facing north pose.
PAN_OFFSET=180
PAN_SCALE=1

# camera tilt = TILT_HORIZON + TILT_SCALE * satellite elevation
# Default maps horizon to tilt 0 and zenith to tilt 90 for a top-mounted antenna.
TILT_HORIZON=0
TILT_SCALE=1

MOVE_SPEED=5
MOVE_PRIORITY=1
MOVE_THRESHOLD=3
MANUAL_STEP=5
MOVE_TIMEOUT=20s
RESET_TIMEOUT=90s

# ATOM Cam normally calibrates itself when the camera boots. Leave this false
# unless this proxy should run atomcam_tools moveinit every time it starts.
RESET_ON_START=false

# Run atomcam_tools moveinit when Hamlib opens a new rotator session. This is
# useful around SatNOGS observations, but it adds delay and motor wear.
RESET_ON_SESSION=false
# before = reset before tracking starts; after = reset after tracking finishes; both = both.
RESET_ON_SESSION_MODE=after

# Raw camera position after a reset. Default returns to the front-facing north
# reference pose. Set both -1 to disable this extra post-reset move.
RESET_CAMERA_PAN=180
RESET_CAMERA_TILT=0

LOG_COMMANDS=true

PARK_AZIMUTH=0
PARK_ELEVATION=0
